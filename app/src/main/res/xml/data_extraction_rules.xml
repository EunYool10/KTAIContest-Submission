<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 백업·기기 이전 규칙: 직접 입력한 API 키는 옮기지 않습니다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secret_pref.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secret_pref.xml" />
    </device-transfer>
</data-extraction-rules>
